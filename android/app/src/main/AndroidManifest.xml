<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE: Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <!-- BLE on Android <12 still needs these (no-op on 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- GPS for ride track recording (FusedLocationProviderClient).
         Was previously declared with maxSdkVersion=30 for legacy BLE only;
         now needed at runtime on all API levels for ride GPX export. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Foreground service (BLE link) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Navigation SDK runs guidance in its own location-type foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Optional: auto-start on boot if user enables it -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Notification listener gives us: nav (Google Maps), calls (system Phone), SMS (system Messages), other apps -->
    <!-- NB: per assumptions log A9, we explicitly do NOT request READ_SMS / RECEIVE_SMS -->

    <!-- Weather: outbound HTTP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional: phone location for weather (single-shot, only when user requests location-aware weather) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Safety: SOS path sends an SMS to the configured emergency contact when a crash is detected.
         Per Phase 1 research (A9), Play Store doesn't allow SEND_SMS for non-default-SMS apps; this
         app is sideloaded so the user grants it manually. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Reliability: when the user swipes the app away from Recents we re-launch
         the foreground service via AlarmManager.setExactAndAllowWhileIdle (see
         BikeBridgeService.onTaskRemoved). On Android 12+ this requires one of
         these permissions; USE_EXACT_ALARM is auto-granted for sideloaded /
         calendar-class apps, SCHEDULE_EXACT_ALARM is the user-revocable variant
         and acts as a fallback. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Lets the crash-SOS prompt promote to a full-screen activity from the
         background (heads-up otherwise), so the rider can cancel in time. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- BLE hardware required -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".GixxerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Redline"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        tools:targetApi="34">

        <!-- Google Maps Platform API key (Navigation SDK + Places). Injected from
             android/local.properties MAPS_API_KEY at build time; see app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- singleTask so a location shared from Google Maps / WhatsApp / a browser
             lands in the existing REDLINE task via onNewIntent instead of stacking a
             second MainActivity (and a second NavigationView) on the sender's task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Redline">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share sheet target: "Share" from Google Maps / any app sends the
                 place link as text/plain. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Open Google Maps links directly (user must enable "Open supported
                 links" for REDLINE in App info on Android 12+ since these are not
                 verified app links). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="goo.gl" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="google.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="www.google.co.in" android:pathPrefix="/maps" />
            </intent-filter>
            <!-- geo: URIs (lat,lng or ?q=) from any app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <!-- Receives the Navigation SDK's once-per-second turn-by-turn feed
             (NavInfo) and converts it to cluster frames. Bound by the SDK from
             within our own process; not exported. -->
        <service
            android:name=".gnav.NavInfoReceivingService"
            android:exported="false" />

        <!-- Foreground service holding the BLE link -->
        <service
            android:name=".ble.BikeBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Full-screen "Are you OK?" prompt shown on suspected crash. Launched from the
             service with FLAG_ACTIVITY_NEW_TASK; not exported. -->
        <activity
            android:name=".safety.SosScreen"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Redline" />

        <!-- Captures Google Maps nav notifications + calls + SMS + arbitrary allowlisted apps -->
        <service
            android:name=".notifications.NotificationCaptureService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Boot receiver — only fires if user enabled auto-start -->
        <receiver
            android:name=".ble.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Fires the crash SOS at the countdown deadline, even if the app
             process was killed during the countdown. Not exported — only our own
             AlarmManager PendingIntent triggers it. -->
        <receiver
            android:name=".safety.SosAlarmReceiver"
            android:exported="false" />

        <!-- FileProvider for sharing exported GPX files via ACTION_SEND. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
